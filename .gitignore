# environment and tooling
.venv/
__pycache__/
.claude/
logs/

# raw/: only the large Statcast pull (about 1.5 GB) is excluded; the small pulled
# leaderboard files and the manual FanGraphs export are tracked.
# Recreate with `python run_pipeline.py --pull`.
raw/statcast_pitch_level_2024_2026.csv

# output/: everything here is regenerated from raw/ by run_pipeline.py on every run, the same
# way a dist/ or build/ folder is, so none of it is tracked. The two HTML pages at the repo root
# are the exception: they're the actual viewable deliverable, not just an intermediate.
output/

.pytest_cache/

